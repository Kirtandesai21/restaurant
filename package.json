{
  "name": "restaurant",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/cds-fiori": "^2",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/mcp-server": "^0.1.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "cds": {
    "server": {
      "index": true
    },
    "fiori": {
      "bypass_draft": true,
      "preview": true
    },
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "sqlite.db"
        }
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa",
        "fiori": {
          "preview": true
        }
      }
    }
  }
}
